    "test:integration:web-learning": "node --test tests/integration/web-formula-learning.test.mjs",
    "test:integration:adaptive-learning": "node --test tests/integration/api-adaptive-learning.test.mjs",
    "test:productization:math-learning": "npm run test:unit && node scripts/productization/validate_math_learning.mjs",
    "test:productization:math-learning-ui": "node scripts/productization/validate_math_learning_ui.mjs",
    "test:productization:adaptive-learning": "npm run test:unit && node scripts/productization/validate_adaptive_learning.mjs",
    "test:productization:diagnostic-curriculum": "npm run test:unit && node scripts/productization/validate_diagnostic_curriculum.mjs",
    "test:integration:diagnostic-curriculum": "node --test tests/integration/web-diagnostic-curriculum.test.mjs",
    "test:productization:k12-curriculum": "npm run test:unit && node scripts/productization/validate_k12_curriculum.mjs",
    "test:integration:k12-curriculum": "node --test tests/integration/web-k12-curriculum.test.mjs",
    "test:productization:collaboration-runtime": "npm run test:unit && node scripts/productization/validate_collaboration_runtime.mjs",
    "test:integration:collaboration-runtime": "node --test tests/integration/web-collaboration-runtime.test.mjs",
    "test:productization:formula-recall": "npm run test:unit && node scripts/productization/validate_formula_recall.mjs",
    "test:integration:formula-recall": "node --test tests/integration/web-formula-recall.test.mjs",
    "test:productization:formula-application": "npm run test:unit && node scripts/productization/validate_formula_application.mjs",
    "test:integration:formula-application": "node --test tests/integration/web-formula-application.test.mjs",
    "test:productization:formula-application-i18n": "npm run test:unit && node scripts/productization/validate_formula_application_i18n.mjs",
    "test:integration:formula-application-i18n": "node --test tests/integration/web-formula-application-i18n.test.mjs",
    "test:productization:formula-catalog-i18n": "npm run test:unit && node scripts/productization/validate_formula_catalog_i18n.mjs",
    "test:integration:formula-catalog-i18n": "node --test tests/integration/web-formula-catalog-i18n.test.mjs",
    "test:productization:presentation-metadata": "node scripts/productization/validate_presentation_metadata.mjs",
