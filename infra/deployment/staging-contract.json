  },
  "feature_flags": {
    "gate5_ai_pet_behavior": true,
    "production_traffic": false
  },
  "external_configuration_optional_for_local_integration": true,
  "promotion_gates": [
    "artifact_hashes_match",
    "eight_locale_smoke_pass",
    "database_migration_pass",
    "health_check_pass",
    "rollback_rehearsal_pass",
    "external_target_authorized"
