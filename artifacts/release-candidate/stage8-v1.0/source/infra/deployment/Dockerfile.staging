FROM nginx:1.27-alpine

COPY artifacts/staging/v0.1.0/site/ /usr/share/nginx/html/
COPY infra/deployment/nginx.staging.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=5s --timeout=2s --start-period=2s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1/index.html || exit 1
